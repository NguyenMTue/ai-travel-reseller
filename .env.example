# Copy to .env.local; obtain public values from BE1 / Supabase Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key supported as fallback; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for trusted Route Handlers. Never prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SECRET_KEY=
# Chat backend secrets are configured only on the server by BE2.
