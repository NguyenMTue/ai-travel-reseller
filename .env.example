# Copy to .env.local; obtain public values from BE1 / Supabase Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key supported as fallback; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chat backend secrets are configured only on the server by BE2.

# Public domain URL for generating tracking links and metadata (e.g. https://travellink.ai or http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# PostHog project settings (public project token and ingestion host)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Telegram Bot API: keep both values server-side; grant the bot permission to post in the platform channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Gemini Video Pipeline (BE2)
GEMINI_VIDEO_ANALYSIS_MODEL=
GEMINI_VIDEO_GENERATION_MODEL=
# Mandatory fail-closed allowlist for video source URLs (comma-separated hostnames or *.domain.com wildcards)
VIDEO_SOURCE_ALLOWED_HOSTS=
