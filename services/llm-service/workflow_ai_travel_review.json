        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent?key={{ $json.body.gemini_api_key || $env.GEMINI_API_KEY || 'YOUR_GEMINI_API_KEY' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [\n    {\n      parts: [\n        {\n          text: 'Bạn là chuyên gia sáng tạo nội dung du lịch cho AI Travel Reseller Platform. Hãy viết bản nháp review du lịch tiếng Việt dựa trên dữ liệu đã xác thực sau:\\n\\n- Merchant: ' + ($json.body.merchant_name || 'Đại lý') + '\\n- Sản phẩm: ' + ($json.body.product_name || '') + '\\n- Địa điểm: ' + ($json.body.location || '') + '\\n- Thông tin xác thực: ' + ($json.body.verified_facts || '') + '\\n- Giá xác nhận: ' + ($json.body.confirmed_price_offer || '') + '\\n- Đối tượng: ' + ($json.body.target_audience || 'Gia đình & giới trẻ') + '\\n- Link đặt chỗ chính thức: ' + ($json.body.official_booking_url || '') + '\\n\\nQUY TẮC BẮT BUỘC:\\n1. Chỉ dùng thông tin đã xác thực ở trên, tuyệt đối không bịa thêm giá hoặc ưu đãi ảo.\\n2. Bố cục bài viết gồm: Tiêu đề thu hút, Nội dung review trải nghiệm chân thực, Lời kêu gọi đặt vé (CTA), Kèm link đặt chỗ chính thức.\\n3. Ghi rõ ở cuối: [BẢN NHÁP KIỂM DUYỆT - CHƯA ĐĂNG MẠNG XÃ HỘI]'\n        }\n      ]\n    }\n  ]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "id": "22222222-2222-4222-a222-222222222222",
      "name": "Gemini AI Generate Draft",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 3000
    },
