# ==============================================================================
# AI TRAVEL RESELLER - LLM & CONTENT SERVICE ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền các giá trị thực tế trước khi chạy.
# ==============================================================================

# 1. SUPABASE (Local mặc định, hoặc Cloud khi deploy)
# Cấu hình Supabase Local (chạy bằng `npx supabase start`):
SUPABASE_URL=http://127.0.0.1:54321
# Local service_role key lấy từ output của `npx supabase status`:
SUPABASE_KEY=your_supabase_service_role_key_here

# 2. GEMINI API KEY (Dùng cho n8n Workflow & Google AI Studio)
# Lấy API key tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. GROQ CLOUD API (Bắt buộc để sinh kịch bản & hooks qua model Qwen/Llama)
# Đăng ký và lấy key miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 4. RAG FASTAPI SERVICE (Tùy chọn - Dùng khi n8n gọi vào rag_api.py)
# Chuỗi bí mật ngẫu nhiên tối thiểu 32 ký tự dùng cho Header 'X-API-Key'
RAG_API_KEY=your_random_secret_rag_api_key_at_least_32_chars

# 4b. CONTENT WRITE API (Dùng từ n8n HTTP Request tới /contents/batch)
# Dùng chuỗi bí mật riêng, tối thiểu 32 ký tự; không dùng lại khóa Supabase.
CONTENTS_API_KEY=your_separate_random_contents_api_key_at_least_32_chars

# 5. N8N WORKFLOW INTEGRATION (Mặc định n8n local port 5678)
N8N_REVIEW_WEBHOOK_URL=http://127.0.0.1:5678/webhook/ai-travel-review
N8N_WEBHOOK_TOKEN=
REVIEW_SHEET_URL=https://docs.google.com/spreadsheets/d/your_google_sheet_id_here

# 6. TIKTOK DEVELOPER API (Tùy chọn - Thử nghiệm đăng video TikTok)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://your-domain.example/tiktok/callback
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
