# ==============================================================================
# AI TRAVEL RESELLER - LLM & CONTENT SERVICE ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền các giá trị thực tế trước khi chạy.
# ==============================================================================

# 1. SUPABASE (Bắt buộc để lưu nội dung và lấy thông tin tour)
SUPABASE_URL=https://your-project.supabase.co
# Bắt buộc dùng service_role key để có quyền ghi dữ liệu vào bảng 'contents'
SUPABASE_KEY=your_supabase_service_role_key

# 2. GROQ CLOUD API (Bắt buộc để sinh kịch bản & hooks qua model Qwen/Llama)
# Đăng ký và lấy key miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 3. RAG FASTAPI SERVICE (Tùy chọn - Dùng khi n8n gọi vào rag_api.py)
# Chuỗi bí mật ngẫu nhiên tối thiểu 32 ký tự dùng cho Header 'X-API-Key'
RAG_API_KEY=your_random_secret_rag_api_key_at_least_32_chars

# 4. N8N WORKFLOW INTEGRATION (Tùy chọn - Luồng n8n review qua Google Sheets)
N8N_REVIEW_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ai-travel-review
N8N_WEBHOOK_TOKEN=your_optional_webhook_secret_token
REVIEW_SHEET_URL=https://docs.google.com/spreadsheets/d/your_google_sheet_id

# 5. TIKTOK DEVELOPER API (Tùy chọn - Thử nghiệm đăng video TikTok)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://your-domain.example/tiktok/callback
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
